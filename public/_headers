# Applies to static assets only; responses from Pages Functions (/s/*, /api/*)
# set their own headers in src/share-handler.ts. Pages already sends
# `X-Content-Type-Options: nosniff` and a referrer policy on static assets.
#
# Font files are pinned by version and SHA-256 in scripts/build-fonts.mjs and
# rarely change, so browsers may reuse them for a day instead of revalidating
# on every page view. /assets/theme.css keeps the default revalidation so a
# new deploy takes effect immediately.
/fonts/*
  Cache-Control: public, max-age=86400

# The admin page (admin UI spec §10): same-origin script, styles, fonts and
# API calls only. No inline script or style attributes, so neither needs an
# exception. `no-cache` makes browsers revalidate app.js after every deploy.
# Cloudflare Access protects these paths before they reach Pages.
/admin/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: no-cache
